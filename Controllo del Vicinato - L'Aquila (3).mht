<body>
    <!-- Access Gate -->
    <div id="accessGate" style="position: fixed; inset: 0px; background: rgb(26, 26, 26); z-index: 9999; display: none; align-items: center; justify-content: center; flex-direction: column; color: white; text-align: center; padding: 1rem;">
        <div style="background:white; color:#1a1a1a; padding:2rem; border-radius:16px; max-width:380px; width:100%; border:2px solid #D4AF37;">
            <h2 style="margin-bottom:0.5rem; color:#1a1a1a;">Accesso Riservato</h2>
            <p style="margin-bottom:1.5rem; color:#555;">Inserisci la password del gruppo</p>
            <input type="password" id="accessPin" placeholder="Password" style="width:100%; padding:12px; font-size:1.1rem; border:1px solid #ccc; border-radius:8px; margin-bottom:1rem; text-align:center;">
            <button style="width:100%; padding:12px; background:#1a1a1a; color:#D4AF37; border:none; border-radius:8px; font-size:1rem; font-weight:600; cursor:pointer;">Entra</button>
            <p id="accessError" style="color:#c0392b; margin-top:1rem; display:none;">Password non corretta</p>
        </div>
    </div>

    
    <header>
        <div class="logo-container">
            <img src="data:image/jpeg;base64," alt="Logo Controllo del Vicinato L'Aquila" style="height:70px; border-radius:8px; border:2px solid #D4AF37; background:white;">
            <h1>Controllo del Vicinato<br><span>CittÃ  di L'Aquila â€¢ IMMOTA MANET</span></h1>
        </div>
        <nav>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#home" class="active">Home</a>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#segnala">Segnala</a>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#mappa">Mappa</a>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#gruppi">Gruppi</a>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#chat">Chat</a>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#coordinatore">Coordinatore</a>
            <a href="https://dorcla.github.io/Controllo-Vicinato/#info">Info</a>
        </nav>
