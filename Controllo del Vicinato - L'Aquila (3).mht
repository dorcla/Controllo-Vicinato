@charset "utf-8";

:root { --gold: #D4AF37; --black: #1a1a1a; --white: #ffffff; --silver: #f4f4f4; --green: #2e7d32; --red: #c62828; --shadow: 0 4px 12px rgba(0,0,0,0.1); }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, rgb(248, 249, 250) 0%, rgb(233, 236, 239) 100%); color: var(--black); line-height: 1.6; }

header { background: var(--black); color: var(--white); padding: 1rem 2rem; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow); position: sticky; top: 0px; z-index: 1000; }

.logo-container { display: flex; align-items: center; gap: 1rem; }

.logo-container img { height: 70px; border-radius: 8px; border: 2px solid var(--gold); }

header h1 { font-size: 1.4rem; font-weight: 600; letter-spacing: 0.5px; }

header h1 span { color: var(--gold); display: block; font-size: 0.85rem; font-weight: 400; }

nav a { color: var(--white); text-decoration: none; margin-left: 1rem; font-size: 0.9rem; transition: color 0.2s; }

nav a:hover, nav a.active { color: var(--gold); }

.container { max-width: 1200px; margin: 2rem auto; padding: 0px 1.5rem; }

.hero { text-align: center; padding: 2rem 0px 3rem; background: white; border-radius: 16px; box-shadow: var(--shadow); margin-bottom: 2rem; }

.hero img { max-width: 200px; margin: 1rem auto; border-radius: 12px; }

.hero h2 { color: var(--black); font-size: 2rem; margin-bottom: 0.5rem; }

.hero p { max-width: 700px; margin: 0px auto; color: rgb(85, 85, 85); }

.section { background: white; border-radius: 12px; padding: 1.8rem; margin-bottom: 1.5rem; box-shadow: var(--shadow); }

.section h2 { color: var(--black); border-bottom: 3px solid var(--gold); padding-bottom: 0.5rem; margin-bottom: 1.2rem; font-size: 1.5rem; }

.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }

.card { background: var(--silver); padding: 1.2rem; border-radius: 10px; border-left: 4px solid var(--gold); }

.card h3 { margin-bottom: 0.5rem; color: var(--black); }

form { display: flex; flex-direction: column; gap: 1rem; }

label { font-weight: 600; font-size: 0.95rem; }

input, select, textarea { padding: 0.75rem; border: 1px solid rgb(221, 221, 221); border-radius: 8px; font-size: 1rem; font-family: inherit; }

textarea { min-height: 100px; resize: vertical; }

button, .btn { background: var(--gold); color: var(--black); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0.8rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; font-size: 1rem; transition: transform 0.1s, background 0.2s; }

button:hover, .btn:hover { background: rgb(201, 162, 39); transform: translateY(-1px); }

.btn-emergency { background: var(--red); color: white; display: inline-block; text-decoration: none; text-align: center; margin: 0.3rem; }

.btn-small { padding: 0.4rem 0.8rem; font-size: 0.85rem; margin-left: 0.5rem; }

.btn-geo { background: rgb(21, 101, 192); color: white; width: fit-content; }

.reports-list { list-style: none; }

.report-item { background: rgb(255, 248, 225); border-left: 4px solid var(--gold); padding: 1rem; margin-bottom: 0.8rem; border-radius: 8px; font-size: 0.95rem; position: relative; }

.report-item.handled { background: rgb(232, 245, 233); border-left-color: var(--green); opacity: 0.85; }

.report-item.high { border-left-color: var(--red); }

.report-item strong { color: var(--black); }

.report-item img.preview { max-width: 120px; max-height: 80px; margin-top: 0.5rem; border-radius: 6px; }

#map { height: 450px; border-radius: 12px; border: 2px solid var(--gold); margin-bottom: 1rem; }

.zones { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }

.zone-tag { background: var(--black); color: var(--gold); padding: 0.4rem 0.8rem; border-radius: 20px; font-size: 0.85rem; cursor: pointer; }

.zone-tag:hover { background: rgb(51, 51, 51); }

.stats { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; justify-content: center; }

.stat-box { background: var(--black); color: var(--gold); padding: 1rem 1.5rem; border-radius: 8px; text-align: center; min-width: 110px; }

.stat-box .num { font-size: 1.8rem; font-weight: bold; }

.hidden { display: none; }

.chat-box { height: 250px; overflow-y: auto; border: 1px solid rgb(221, 221, 221); border-radius: 8px; padding: 1rem; background: rgb(250, 250, 250); margin-bottom: 1rem; }

.chat-msg { margin-bottom: 0.6rem; padding: 0.5rem 0.8rem; background: rgb(227, 242, 253); border-radius: 12px; max-width: 80%; }

.chat-msg.me { background: rgb(255, 243, 224); margin-left: auto; }

.filters { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }

.filters input, .filters select { flex: 1 1 0%; min-width: 150px; }

#fotoPreview { max-width: 150px; margin-top: 0.5rem; border-radius: 8px; display: none; }

footer { text-align: center; padding: 2rem; color: rgb(204, 204, 204); font-size: 0.9rem; background: var(--black); }

footer strong { color: var(--gold); }

@media (max-width: 768px) {
  header { flex-direction: column; gap: 1rem; text-align: center; }
  nav a { margin: 0px 0.4rem; font-size: 0.85rem; }
  .logo-container img { height: 60px; }
}
